{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(admin|portal|operador|entrar|cotizacion)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/publi-escuela",
      "destination": "/publi-escuela.html"
    },
    {
      "source": "/(admin|portal|operador|entrar|cotizacion)(.*)",
      "destination": "/index.html"
    }
  ]
}
